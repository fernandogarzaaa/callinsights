# CallInsights configuration. Copy to .env and adjust. Every value can also be set as an
# environment variable. NEVER commit a real .env file.

# --- Runtime ---------------------------------------------------------------------------------
# development | production | test. production enforces a strong SECRET_KEY and secure cookies.
ENV=development
APP_NAME=CallInsights
PORT=8003
WORKERS=1
LOG_LEVEL=INFO
# json (one JSON object per line) | text
LOG_FORMAT=json

# --- Storage ---------------------------------------------------------------------------------
# SQLite for a single node; PostgreSQL for production (docker-compose sets this for you):
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/callinsights
DATABASE_URL=sqlite:///./data/callinsights.db
# Apply Alembic migrations automatically at startup (or run `callinsights migrate`).
AUTO_MIGRATE=1
# Uploaded audio lives in $DATA_DIR/uploads.
DATA_DIR=./data
MAX_UPLOAD_MB=200

# --- Security --------------------------------------------------------------------------------
# REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Defaults to true when ENV=production. Set false only for plain-HTTP local testing.
# COOKIE_SECURE=
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Extra origins allowed to make cookie-authenticated writes (comma-separated).
# TRUSTED_ORIGINS=https://callinsights.example.com

# --- Bootstrap admin (created on first start if it does not exist) ----------------------------
ADMIN_EMAIL=admin@example.com
# At least 10 characters, mixing letters with digits or symbols.
ADMIN_PASSWORD=
# Load five demo calls on startup.
SEED_DEMO_DATA=0

# --- PostgreSQL (docker-compose only) -----------------------------------------------------------
POSTGRES_USER=callinsights
POSTGRES_PASSWORD=
POSTGRES_DB=callinsights
# Docker image extras: "postgres" or "postgres,asr" (bundles faster-whisper + ffmpeg).
DOCKER_EXTRAS=postgres

# --- LLM: any OpenAI-compatible endpoint (optional) ------------------------------------------
# auto: use the endpoint when LLM_BASE_URL is set, otherwise the offline local engine.
# local: always offline/deterministic. openai: require LLM_BASE_URL.
LLM_PROVIDER=auto
# Free options:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<any ":free" model>
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1  (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Let the LLM label speakers on speech-to-text transcripts.
LLM_SPEAKER_LABELING=1

# --- Speech-to-text (optional) ---------------------------------------------------------------
# none | mock | faster-whisper | openai
#   faster-whisper: local and free; pip install 'callinsights[asr]' (or DOCKER_EXTRAS=postgres,asr)
#   openai: any /audio/transcriptions endpoint, e.g. Groq (ASR_MODEL=whisper-large-v3)
ASR_PROVIDER=none
# Default to LLM_BASE_URL / LLM_API_KEY when empty.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# ASR_LANGUAGE=en
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# Heuristic speaker-change pause (seconds) when no LLM labels speakers.
DIARIZATION_GAP_SECONDS=0.8
ASR_FIRST_SPEAKER=agent
